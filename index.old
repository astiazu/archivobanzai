<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Archivo BanZai — memoria, música, fotografías y testimonios de BanZai Saldán y BanZai Mina Clavero.">
  <title>Archivo BanZai — La memoria de una generación</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <div class="noise"></div>

  <header class="site-header">
    <a class="brand" href="#inicio" aria-label="Archivo BanZai">
      <span class="brand-mark">BAN<span>ZAI</span></span>
      <span class="brand-sub">ARCHIVO</span>
    </a>
    <nav>
      <a href="#historia">Historia</a>
      <a href="#radio">Radio</a>
      <a href="#recuerdos">Recuerdos</a>
      <a href="#testimonios">Testimonios</a>
    </nav>
    <a class="header-cta" href="#participa">Yo estuve ahí <span>↗</span></a>
  </header>

  <main id="inicio">
    <section class="hero">
      <div class="hero-grid"></div>
      <div class="hero-copy">
        <p class="eyebrow">Mina Clavero · Saldán · Córdoba</p>
        <h1>LAS NOCHES<br><em>NO SE BORRAN.</em></h1>
        <p class="hero-text">Estamos reconstruyendo la historia de BanZai a través de quienes la vivieron: música, fotos, videos, voces y recuerdos.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#historia">Entrar al archivo</a>
          <a class="btn btn-ghost" href="#radio">Escuchar BanZai Radio ◉</a>
        </div>
      </div>
      <div class="hero-art">
        <div class="logo-card old">
          <img src="assets/banzai-logo-historico.jpg" alt="Logo histórico de BanZai">
          <span>MEMORIA / 01</span>
        </div>
        <div class="logo-card current">
          <img src="assets/banzai-logo-actual.png" alt="Logo actual de BanZai">
          <span>ENERGY / HOY</span>
        </div>
      </div>
      <div class="scroll-hint">SCROLL <span>↓</span></div>
    </section>

    <section class="intro section" id="historia">
      <div class="section-label">01 / LA HISTORIA</div>
      <div class="intro-layout">
        <div>
          <h2>Una historia que<br><span>merece ser contada.</span></h2>
        </div>
        <div>
          <p class="lead">Archivo BanZai nace para recuperar la memoria de dos lugares que quedaron grabados en generaciones de cordobeses y visitantes.</p>
          <p>BanZai Saldán y BanZai Mina Clavero. Dos nombres, miles de noches y una banda sonora que atravesó décadas. Este sitio todavía está en construcción: cada fecha, foto y testimonio que incorporemos va a ayudar a armar el archivo.</p>
        </div>
      </div>
    </section>

    <section class="timeline section">
      <div class="section-label">02 / LÍNEA DEL TIEMPO</div>
      <div class="timeline-track">
        <article class="time-card featured">
          <span class="year">1984</span>
          <h3>MINA CLAVERO</h3>
          <p>El comienzo de la etapa histórica que queremos documentar con fotos, documentos y testimonios.</p>
          <span class="status">EN INVESTIGACIÓN</span>
        </article>
        <article class="time-card">
          <span class="year">1986</span>
          <h3>LA MÚSICA SALE A LA PLAYA</h3>
          <p>Un capítulo para reconstruir con los protagonistas y archivos de la época.</p>
          <span class="status">FUENTES + TESTIMONIOS</span>
        </article>
        <article class="time-card">
          <span class="year">1990s</span>
          <h3>LA GENERACIÓN BANZAI</h3>
          <p>Veranos, amigos, DJs, fiestas y canciones. Acá necesitamos tus recuerdos.</p>
          <span class="status">SUMÁ MATERIAL</span>
        </article>
        <article class="time-card">
          <span class="year">2000</span>
          <h3>FIN DE UNA ETAPA</h3>
          <p>El cierre del período que forma parte del núcleo histórico del archivo.</p>
          <span class="status">POR DOCUMENTAR</span>
        </article>
      </div>
    </section>

    <section class="radio section" id="radio">
      <div class="radio-top">
        <div>
          <div class="section-label">03 / BANZAI RADIO</div>
          <h2>La música<br><span>te lleva de vuelta.</span></h2>
        </div>
        <div class="radio-now">
          <span class="live-dot"></span> RADIO CONCEPTUAL
          <strong id="nowPlaying">Elegí una época para comenzar</strong>
        </div>
      </div>

      <div class="radio-player">
        <div class="disc"><div class="disc-hole"></div></div>
        <div class="player-main">
          <span class="player-kicker">BANZAI ARCHIVE MIX</span>
          <h3 id="trackTitle">Seleccioná una playlist</h3>
          <p id="trackMeta">Las pistas reales se incorporarán en la siguiente etapa.</p>
          <div class="fake-progress"><span id="progress"></span></div>
          <div class="player-controls">
            <button id="prevBtn" aria-label="Anterior">↶</button>
            <button id="playBtn" class="play" aria-label="Reproducir">▶</button>
            <button id="nextBtn" aria-label="Siguiente">↷</button>
          </div>
        </div>
        <div class="playlist-list" id="playlistList"></div>
      </div>

      <div class="radio-tags">
        <button data-playlist="70s">70s</button>
        <button data-playlist="80s">80s</button>
        <button data-playlist="90s">90s</button>
        <button data-playlist="2000s">2000s</button>
        <button data-playlist="rock">Rock</button>
        <button data-playlist="dance">Dance</button>
        <button data-playlist="latino">Latinos</button>
        <button data-playlist="banzai">BanZai Memories</button>
      </div>
    </section>

    <section class="memories section" id="recuerdos">
      <div class="section-label">04 / EL ÁLBUM</div>
      <div class="memories-head">
        <h2>¿Tenés una foto<br>de <span>BanZai?</span></h2>
        <p>Este mosaico es una maqueta. La versión real va a permitir cargar, moderar y catalogar material enviado por la comunidad.</p>
      </div>
      <div class="memory-grid">
        <div class="memory memory-a"><span>FOTO / 001</span><b>¿QUIÉN SE ACUERDA DE ESTA NOCHE?</b></div>
        <div class="memory memory-b"><span>VIDEO / 002</span><b>UN VERANO QUE NO SE OLVIDA</b></div>
        <div class="memory memory-c"><span>FLYER / 003</span><b>LA NOCHE EMPEZABA ACÁ</b></div>
        <div class="memory memory-d"><span>TESTIMONIO / 004</span><b>“YO ESTUVE AHÍ”</b></div>
      </div>
    </section>

    <section class="testimonials section" id="testimonios">
      <div class="section-label">05 / VOCES</div>
      <div class="testimonials-layout">
        <div>
          <h2>La historia<br>la cuentan <span>ellos.</span></h2>
          <p>Un archivo vivo necesita voces reales. La idea es registrar testimonios en texto, audio y video, asociados a un año y a una sede.</p>
          <a class="text-link" href="#participa">Quiero contar mi historia →</a>
        </div>
        <div class="quote">
          <div class="quote-mark">“</div>
          <blockquote>Este espacio está reservado para el primer testimonio de la comunidad BanZai.</blockquote>
          <p>— Próximamente, una voz de nuestra historia</p>
        </div>
      </div>
    </section>

    <section class="participate" id="participa">
      <div class="participate-inner">
        <span class="section-label">06 / PARTICIPÁ</span>
        <h2>¿VOS TAMBIÉN<br><em>ESTUVISTE AHÍ?</em></h2>
        <p>Mandanos tu recuerdo. Puede ser una foto, un video, un audio, un flyer, una entrada o simplemente una historia.</p>
        <button class="btn btn-primary big" id="uploadDemo">SUBIR MI RECUERDO <span>↗</span></button>
        <small>Demo frontend · el formulario real y la moderación se conectarán al backend.</small>
      </div>
    </section>
  </main>

  <footer>
    <div class="footer-brand">BAN<span>ZAI</span></div>
    <p>ARCHIVO BANZAI · MINA CLAVERO / SALDÁN</p>
    <p class="muted">Un proyecto de memoria, música y comunidad.</p>
  </footer>

  <dialog id="demoDialog">
    <button class="dialog-close" id="closeDialog" aria-label="Cerrar">×</button>
    <span class="section-label">SUMAR AL ARCHIVO</span>
    <h2>Contanos tu recuerdo.</h2>
    <label>Nombre
      <input type="text" placeholder="¿Cómo te llamabas en aquella época?">
    </label>
    <label>Sede
      <select><option>Mina Clavero</option><option>Saldán</option><option>Ambas</option><option>No estoy seguro</option></select>
    </label>
    <label>Año aproximado
      <input type="text" placeholder="Ej.: 1992">
    </label>
    <label>Tu historia
      <textarea rows="4" placeholder="¿Qué recordás?"></textarea>
    </label>
    <button class="btn btn-primary" id="sendDemo">ENVIAR (DEMO)</button>
    <p id="dialogMessage" class="dialog-message"></p>
  </dialog>

  <script src="app.js"></script>
</body>
</html>
